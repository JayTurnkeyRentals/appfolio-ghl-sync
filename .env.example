# AppFolio Reports API credentials (General Settings -> Manage API Settings -> Reports API Credentials)
APPFOLIO_CLIENT_ID=
APPFOLIO_CLIENT_SECRET=
# Subdomain only, e.g. "mycompany" for mycompany.appfolio.com
APPFOLIO_DATABASE=
# Report resource name (without .json), confirm exact value in your AppFolio API settings
APPFOLIO_GUEST_CARD_REPORT=guest_card_inquiries

# GoHighLevel Private Integration Token + sub-account location id
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# Optional: path to the SQLite state DB (default: ./data/state.db)
STATE_DB_PATH=./data/state.db

# Optional: how many days back to look on the very first run (default: 1)
INITIAL_LOOKBACK_DAYS=1
